{
	# Railway has its own TLS edge; Caddy only speaks plain HTTP behind it.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Hashed build assets never change; HTML must always revalidate so deploys show up at once.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html not path /_next/static/*
	header @html Cache-Control "public, max-age=0, must-revalidate"

	file_server

	# Next static export writes 404.html; keep the 404 status.
	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
