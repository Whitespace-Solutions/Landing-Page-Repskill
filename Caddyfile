{
	# Railway has its own TLS edge; Caddy only speaks plain HTTP behind it.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Hashed build assets never change; HTML must always revalidate so deploys show up at once.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html not path /_next/static/*
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Temporary (302), not 308: browsers cache a 308 for good, and /features/ may become a real page later.
	redir /features /features/capture-knowledge/ 302
	redir /features/ /features/capture-knowledge/ 302

	# The LinkedIn-persona guide page was removed (the feature is not live); its old, already-indexed URL
	# goes to the User Guide instead of falling through to the app's login wall below.
	redir /guide/user/linkedin-persona* /guide/user/ 302

	file_server

	# repskill.ai is the marketing site; the product lives on app.repskill.ai. Anything this site
	# does not have (old emailed links such as /reset-password?token=..., /join/..., /login, /api/...)
	# goes to the same path on the app. 308 keeps method, path and query.
	handle_errors {
		@notfound expression {err.status_code} == 404
		redir @notfound https://app.repskill.ai{uri} 308
	}
}
